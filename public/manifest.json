{
  "manifest_version": 3,
  "name": "Blasito",
  "version": "0.1.0",
  "description": "Expansión local de snippets de texto.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
