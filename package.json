{
  "name": "blasito",
  "version": "1.0.0",
  "description": "Local-first text expander for Chromium: type a shortcut, get your saved text.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabialonso/blasito.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "package": "npm run build && cp src/shared/fonts/*.txt dist/ && rm -f blasito.zip && cd dist && zip -qr ../blasito.zip .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
